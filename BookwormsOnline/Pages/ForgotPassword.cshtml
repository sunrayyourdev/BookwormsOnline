@page
@model BookwormsOnline.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow">
            <div class="card-body p-5">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-question-circle"></i> Forgot Password
                </h2>

                <form method="post" class="needs-validation">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label">
                            <i class="bi bi-envelope"></i> Email Address
                        </label>
                        <input asp-for="Input.Email" class="form-control form-control-lg" 
                               autocomplete="email" aria-required="true" 
                               placeholder="you@example.com" />
                        <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                        <i class="bi bi-send"></i> Send Reset Link
                    </button>

                    <div class="d-grid gap-2">
                        <a asp-page="/Login" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-in-right"></i> Back to Login
                        </a>
                    </div>
                </form>

                <hr class="my-4">

                <p class="text-center text-muted mb-0">
                    We'll send you a link to reset your password.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
