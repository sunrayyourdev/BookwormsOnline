@page
@model BookwormsOnline.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <hr />
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <input type="hidden" id="recaptchaToken" asp-for="Input.Token" />
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                </div>
                <div class="mt-3">
                    <a asp-page="./ForgotPassword">Forgot your password?</a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!string.IsNullOrEmpty(Model.ReCaptchaSiteKey))
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@Model.ReCaptchaSiteKey"></script>
        <script>
            var recaptchaInitialized = false;

            // Execute reCAPTCHA on page load to display the badge
            window.addEventListener('load', function () {
                grecaptcha.ready(function () {
                    // Execute once on page load to render the reCAPTCHA badge
                    grecaptcha.execute('@Model.ReCaptchaSiteKey', { action: 'page_load' }).then(function (token) {
                        console.log('reCAPTCHA badge initialized on page load');
                        recaptchaInitialized = true;
                    }).catch(function (error) {
                        console.error('Failed to initialize reCAPTCHA badge:', error);
                    });
                });

                // Attach form submission handler only once
                if (!recaptchaInitialized) {
                    var form = document.getElementById('account');
                    form.addEventListener('submit', handleFormSubmit);
                }
            });

            // Handle form submission with fresh reCAPTCHA token
            function handleFormSubmit(e) {
                e.preventDefault();
                
                // Disable submit button to prevent double submissions
                var submitButton = document.getElementById('login-submit');
                submitButton.disabled = true;
                var originalText = submitButton.textContent;
                submitButton.textContent = 'Signing in...';
                
                console.log('Form submit event triggered, requesting fresh reCAPTCHA token');

                grecaptcha.ready(function () {
                    // Execute reCAPTCHA to get a fresh token for this attempt
                    grecaptcha.execute('@Model.ReCaptchaSiteKey', { action: 'login' }).then(function (token) {
                        if (token && token.length > 0) {
                            // Set the token in the hidden field
                            document.getElementById('recaptchaToken').value = token;
                            console.log('Fresh reCAPTCHA token generated successfully: ' + token.substring(0, 10) + '...');
                            
                            // Use setTimeout to ensure token is set before form submission
                            setTimeout(function () {
                                document.getElementById('account').submit();
                            }, 100);
                        } else {
                            console.error('Failed to generate reCAPTCHA token - token is empty');
                            submitButton.disabled = false;
                            submitButton.textContent = originalText;
                        }
                    }).catch(function (error) {
                        console.error('reCAPTCHA execution error:', error);
                        submitButton.disabled = false;
                        submitButton.textContent = originalText;
                    });
                });
            }
        </script>
    }
    else
    {
        <script>
            console.error('reCAPTCHA SiteKey not configured. Check RECAPTCHA_SITEKEY environment variable.');
        </script>
    }
}
