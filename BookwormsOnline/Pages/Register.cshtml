@page
@model BookwormsOnline.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow">
            <div class="card-body p-5">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-person-plus"></i> Register
                </h2>

                <form method="post" enctype="multipart/form-data" class="needs-validation">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.FirstName" class="form-label">
                                <i class="bi bi-person"></i> First Name
                            </label>
                            <input asp-for="Input.FirstName" class="form-control form-control-lg" required pattern="^[a-zA-Z\s'-]+$" title="First Name can only contain letters, spaces, hyphens, and apostrophes." />
                            <span asp-validation-for="Input.FirstName" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.LastName" class="form-label">
                                <i class="bi bi-person"></i> Last Name
                            </label>
                            <input asp-for="Input.LastName" class="form-control form-control-lg" required pattern="^[a-zA-Z\s'-]+$" title="Last Name can only contain letters, spaces, hyphens, and apostrophes." />
                            <span asp-validation-for="Input.LastName" class="invalid-feedback d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">
                            <i class="bi bi-envelope"></i> Email Address
                        </label>
                        <input asp-for="Input.Email" type="email" class="form-control form-control-lg" required />
                        <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Password" class="form-label">
                                <i class="bi bi-lock"></i> Password
                            </label>
                            <input asp-for="Input.Password" class="form-control form-control-lg" id="passwordInput" onkeyup="checkPasswordStrength()" required pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{12,100}$" title="Password must be at least 12 characters long and include at least one uppercase letter, one lowercase letter, one number, and one special character (e.g., @@, $, !, %, , ?, &)." />
                            <div id="password-strength-meter" class="mt-2">
                                <div id="password-strength-meter-fill"></div>
                            </div>
                            <small id="password-strength-text" class="form-text text-muted"></small>

                            <div id="password-checklist" class="mt-3">
                                <div id="check-length" class="checklist-item"><i class="bi bi-circle"></i> Minimum 12 characters</div>
                                <div id="check-upper" class="checklist-item"><i class="bi bi-circle"></i> At least one uppercase letter</div>
                                <div id="check-lower" class="checklist-item"><i class="bi bi-circle"></i> At least one lowercase letter</div>
                                <div id="check-number" class="checklist-item"><i class="bi bi-circle"></i> At least one number</div>
                                <div id="check-special" class="checklist-item"><i class="bi bi-circle"></i> At least one special character</div>
                            </div>
                            <span asp-validation-for="Input.Password" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">
                                <i class="bi bi-check2-circle"></i> Confirm Password
                            </label>
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" required/>
                            <span asp-validation-for="Input.ConfirmPassword" class="invalid-feedback d-block"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Mobile" class="form-label">
                                <i class="bi bi-telephone"></i> Mobile
                            </label>
                            <input asp-for="Input.Mobile" class="form-control form-control-lg" required pattern="^[89]\d{7}$" inputmode="numeric" maxlength="8" title="Invalid Mobile Number." />
                            <span asp-validation-for="Input.Mobile" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.CreditCardNumber" class="form-label">
                                <i class="bi bi-credit-card"></i> Credit Card Number
                            </label>
                            <input asp-for="Input.CreditCardNumber" class="form-control form-control-lg" required pattern="^\d{16}$" inputmode="numeric" maxlength="16" title="Credit Card Number must be 16 digits." />
                            <span asp-validation-for="Input.CreditCardNumber" class="invalid-feedback d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.BillingAddress" class="form-label">
                            <i class="bi bi-geo-alt"></i> Billing Address
                        </label>
                        <textarea asp-for="Input.BillingAddress" class="form-control form-control-lg" rows="3" required maxlength="500" data-val="true" data-val-regex="Address can only contain letters, numbers, spaces, hyphens, commas, periods, apostrophes, and parentheses." data-val-regex-pattern="^[a-zA-Z0-9\s\-,'().]+$"></textarea>
                        <span asp-validation-for="Input.BillingAddress" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ShippingAddress" class="form-label">
                            <i class="bi bi-truck"></i> Shipping Address
                        </label>
                        <textarea asp-for="Input.ShippingAddress" class="form-control form-control-lg" rows="3" required maxlength="500"></textarea>
                        <span asp-validation-for="Input.ShippingAddress" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Photo" class="form-label">
                            <i class="bi bi-camera"></i> Profile Photo (optional)
                        </label>
                        <input asp-for="Input.Photo" type="file" class="form-control" accept="image/jpeg" id="photoInput" onchange="validatePhotoFile()" required />
                        <small class="form-text text-muted">Maximum file size: 2MB. Only JPEG images (.jpg) are allowed.</small>
                        <div id="photoError" class="text-danger mt-2" style="display:none;"></div>
                        <span asp-validation-for="Input.Photo" class="invalid-feedback d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                        <i class="bi bi-person-plus"></i> Create Account
                    </button>

                    <div class="d-grid gap-2">
                        <a asp-page="/Login" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-in-right"></i> Already have an account?
                        </a>
                    </div>
                </form>

                <hr class="my-4">

                <p class="text-center text-muted mb-0">
                    By creating an account, you agree to our security and privacy practices.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Maximum file size in bytes (2MB)
        const MAX_FILE_SIZE = 2 * 1024 * 1024;
        const ALLOWED_MIME_TYPE = 'image/jpeg';

        function validatePhotoFile() {
            const fileInput = document.getElementById('photoInput');
            const photoError = document.getElementById('photoError');
            const file = fileInput.files[0];

            // Clear previous error
            photoError.style.display = 'none';
            photoError.innerText = '';

            // If no file selected, that's okay (optional field)
            if (!file) {
                return true;
            }

            // Check MIME type
            if (file.type !== ALLOWED_MIME_TYPE) {
                photoError.innerText = 'Invalid file type. Only JPEG images are allowed. Please select a .jpg or .jpeg file.';
                photoError.style.display = 'block';
                fileInput.value = ''; // Clear the input
                return false;
            }

            // Check file size
            if (file.size > MAX_FILE_SIZE) {
                const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);
                const maxSizeMB = (MAX_FILE_SIZE / (1024 * 1024)).toFixed(0);
                photoError.innerText = `File is too large. The file size is ${fileSizeMB}MB but maximum allowed is ${maxSizeMB}MB. Please select a smaller file.`;
                photoError.style.display = 'block';
                fileInput.value = ''; // Clear the input
                return false;
            }

            return true;
        }

        // Also validate on form submit
        document.querySelector('form').addEventListener('submit', function (e) {
            if (!validatePhotoFile() && document.getElementById('photoInput').files.length > 0) {
                e.preventDefault();
                return false;
            }
        });
    </script>
}
