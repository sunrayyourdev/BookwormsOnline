@page
@model BookwormsOnline.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow">
            <div class="card-body p-5">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-shield-lock"></i> Change Password
                </h2>

                <form id="change-password-form" method="post" class="needs-validation">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-info mb-3" role="alert">
                            <i class="bi bi-info-circle"></i> @Model.StatusMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Input.OldPassword" class="form-label">
                            <i class="bi bi-key"></i> Current Password
                        </label>
                        <input asp-for="Input.OldPassword" class="form-control form-control-lg" 
                               autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Input.OldPassword" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label">
                            <i class="bi bi-shield"></i> New Password
                        </label>
                        <input asp-for="Input.NewPassword" class="form-control form-control-lg" 
                               id="passwordInput" onkeyup="checkPasswordStrength()" 
                               autocomplete="new-password" aria-required="true" />
                        <div id="password-strength-meter" class="mt-2">
                            <div id="password-strength-meter-fill"></div>
                        </div>
                        <small id="password-strength-text" class="form-text text-muted"></small>

                        <div id="password-checklist" class="mt-3">
                            <div id="check-length" class="checklist-item"><i class="bi bi-circle"></i> Minimum 12 characters</div>
                            <div id="check-upper" class="checklist-item"><i class="bi bi-circle"></i> At least one uppercase letter</div>
                            <div id="check-lower" class="checklist-item"><i class="bi bi-circle"></i> At least one lowercase letter</div>
                            <div id="check-number" class="checklist-item"><i class="bi bi-circle"></i> At least one number</div>
                            <div id="check-special" class="checklist-item"><i class="bi bi-circle"></i> At least one special character</div>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">
                            <i class="bi bi-check2-circle"></i> Confirm Password
                        </label>
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" 
                               autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.ConfirmPassword" class="invalid-feedback d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                        <i class="bi bi-arrow-repeat"></i> Update Password
                    </button>

                    @if (string.IsNullOrWhiteSpace(Request.Query["expired"]))
                    {
                        <div class="d-grid gap-2">
                            <a asp-page="/Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Profile
                            </a>
                        </div>
                    }
                </form>

                <hr class="my-4">

                <p class="text-center text-muted mb-0">
                    <small>Keep your password secure and unique.</small>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
