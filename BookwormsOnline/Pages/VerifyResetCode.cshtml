@page
@model BookwormsOnline.Pages.VerifyResetCodeModel
@{
    ViewData["Title"] = "Verify Password Reset";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Verifying...</span>
                    </div>
                </div>
                <h2 class="card-title text-center mb-2">Verifying Your Request</h2>
                <p class="text-center text-muted">
                    Please wait while we verify your password reset link...
                </p>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Code))
{
    <form id="verifyForm" method="post" asp-page="/ResetPassword" class="d-none">
        <input type="hidden" name="code" value="@Model.Code" />
    </form>

    <script>
        // Automatically submit the form via POST to keep the code out of access logs
        document.getElementById('verifyForm').submit();
    </script>
}
else
{
    <script>
        // Redirect to forgot password page if no code is provided
        window.location.href = '@(Url.Page("/ForgotPassword"))';
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
