@page
@model BookwormsOnline.Pages.VerifyResetCodeModel
@{
    ViewData["Title"] = "Verify Password Reset";
}

<h1>@ViewData["Title"]</h1>
<p>Please wait while we verify your password reset request...</p>

@if (!string.IsNullOrEmpty(Model.Code))
{
    <form id="verifyForm" method="post" asp-page="/ResetPassword">
        <input type="hidden" name="code" value="@Model.Code" />
    </form>

    <script>
        // Automatically submit the form via POST to keep the code out of access logs
        document.getElementById('verifyForm').submit();
    </script>
}
else
{
    <div class="alert alert-danger">
        Invalid password reset request. Please request a new password reset link.
    </div>
}

