@page
@model BookwormsOnline.Pages.LoginActivityModel
@{
    ViewData["Title"] = "Login Activity";
}

<div class="row">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="bi bi-clock-history"></i> Login Activity</h2>
                <p class="text-muted">Manage your active sessions and security</p>
            </div>
            <a asp-page="/Profile" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Profile
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i> Active Sessions (@Model.ActiveSessions.Count)</h5>
                @if (Model.ActiveSessions.Count > 1)
                {
                    <form method="post" asp-page-handler="RevokeAll" onsubmit="return confirm('Are you sure you want to revoke all other sessions? This will sign out all other devices.');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-x-circle"></i> Revoke All Other Sessions
                        </button>
                    </form>
                }
            </div>
            <div class="card-body">
                @if (Model.ActiveSessions.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                        <p class="text-muted mt-3">No active sessions found.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var session in Model.ActiveSessions)
                        {
                            var isCurrentSession = session.SessionId == Model.CurrentSessionId;
                            var browser = Model.GetBrowserName(session.UserAgent);
                            var device = Model.GetDeviceType(session.UserAgent);
                            
                            <div class="list-group-item @(isCurrentSession ? "border-start border-primary border-4" : "")">
                                <div class="row align-items-center">
                                    <div class="col-md-1 text-center">
                                        @if (device == "Mobile")
                                        {
                                            <i class="bi bi-phone fs-2 text-primary"></i>
                                        }
                                        else if (device == "Tablet")
                                        {
                                            <i class="bi bi-tablet fs-2 text-info"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-display fs-2 text-secondary"></i>
                                        }
                                    </div>
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center mb-1">
                                            <h6 class="mb-0 me-2">@browser on @device</h6>
                                            @if (isCurrentSession)
                                            {
                                                <span class="badge bg-success">Current Session</span>
                                            }
                                        </div>
                                        <div class="text-muted small">
                                            <div>
                                                <i class="bi bi-geo-alt"></i> IP Address: @session.IpAddress
                                            </div>
                                            <div>
                                                <i class="bi bi-clock"></i> Last Active: @session.LastActiveDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            </div>
                                            <div>
                                                <i class="bi bi-calendar"></i> Signed In: @session.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 text-end">
                                        <form method="post" asp-page-handler="Revoke" asp-route-sessionId="@session.Id" 
                                              onsubmit="return confirm('@(isCurrentSession ? "This will sign you out. Are you sure?" : "Are you sure you want to revoke this session?")');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-x-circle"></i> @(isCurrentSession ? "Sign Out" : "Revoke")
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle"></i> About Login Activity</h6>
                <ul class="mb-0">
                    <li class="mb-2">Sessions are created each time you sign in to your account</li>
                    <li class="mb-2">Each session tracks your IP address, browser, and activity</li>
                    <li class="mb-2">Revoking a session will immediately sign out that device</li>
                    <li class="mb-2">Sessions expire automatically after 20 minutes of inactivity</li>
                    <li>If you notice any suspicious activity, revoke the session immediately and change your password</li>
                </ul>
            </div>
        </div>
    </div>
</div>
