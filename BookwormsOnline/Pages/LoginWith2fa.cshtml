@page
@model BookwormsOnline.Pages.LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow">
            <div class="card-body p-5">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-shield-lock"></i> Two-Factor Authentication
                </h2>

                <p class="text-center text-muted mb-4">
                    Your login is protected with an authenticator app. Enter your authenticator code below.
                </p>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="needs-validation">
                    <input asp-for="RememberMe" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.TwoFactorCode" class="form-label">
                            <i class="bi bi-key"></i> Authenticator Code
                        </label>
                        <input asp-for="Input.TwoFactorCode" class="form-control form-control-lg text-center" 
                               autocomplete="off" 
                               placeholder="000000" 
                               inputmode="numeric" minlength="6" maxlength="6" pattern="^\d{6,}$" required 
                               title="Enter a 6 digit verification code." />
                        <span asp-validation-for="Input.TwoFactorCode" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Input.RememberMachine" class="form-check-input" />
                            <label asp-for="Input.RememberMachine" class="form-check-label">
                                Remember this device for 30 days
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                        <i class="bi bi-box-arrow-in-right"></i> Verify & Sign In
                    </button>

                    <div class="d-grid gap-2">
                        <a asp-page="/Login" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Login
                        </a>
                    </div>
                </form>

                <hr class="my-4">

                <p class="text-center text-muted mb-0">
                    <small>Don't have access to your authenticator device? Please contact support.</small>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
