@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section p-5 rounded-4 bg-white shadow-sm mb-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold mb-3">Discover your next favorite book</h1>
            <p class="lead text-muted mb-4">
                Browse curated collections, bestsellers, and new releases. Your bookstore, reimagined for secure and seamless shopping.
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-primary btn-lg" href="#featured">
                    <i class="bi bi-stars"></i> Featured Books
                </a>
                @if (!(User.Identity?.IsAuthenticated ?? false))
                {
                    <a class="btn btn-outline-secondary btn-lg" asp-page="/Login">
                        <i class="bi bi-box-arrow-in-right"></i> Sign In Now
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0">
            <div class="p-4 bg-light rounded-4">
                <h5 class="fw-bold mb-3">Search the catalog</h5>
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search by title, author, or ISBN" />
                    <button class="btn btn-primary" type="button">Search</button>
                </div>
                <small class="text-muted d-block mt-2">Secure checkout and fast delivery available.</small>
            </div>
        </div>
    </div>
</section>

<section id="featured" class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h3 fw-bold mb-0">Featured Books</h2>
        <a class="text-decoration-none" href="#">View all</a>
    </div>
    <div class="row g-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="bg-light rounded-3 p-4 text-center mb-3">
                        <i class="bi bi-book-half fs-1"></i>
                    </div>
                    <h6 class="fw-bold">The Midnight Library</h6>
                    <p class="text-muted small mb-2">Matt Haig</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">$18.99</span>
                        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-cart-plus"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="bg-light rounded-3 p-4 text-center mb-3">
                        <i class="bi bi-book fs-1"></i>
                    </div>
                    <h6 class="fw-bold">Atomic Habits</h6>
                    <p class="text-muted small mb-2">James Clear</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">$21.50</span>
                        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-cart-plus"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="bg-light rounded-3 p-4 text-center mb-3">
                        <i class="bi bi-journal-richtext fs-1"></i>
                    </div>
                    <h6 class="fw-bold">Project Hail Mary</h6>
                    <p class="text-muted small mb-2">Andy Weir</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">$24.00</span>
                        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-cart-plus"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="bg-light rounded-3 p-4 text-center mb-3">
                        <i class="bi bi-bookmark-star fs-1"></i>
                    </div>
                    <h6 class="fw-bold">Tomorrow, and Tomorrow, and Tomorrow</h6>
                    <p class="text-muted small mb-2">Gabrielle Zevin</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">$19.75</span>
                        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-cart-plus"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-white rounded-4 p-4 shadow-sm">
    <div class="row text-center">
        <div class="col-md-4">
            <i class="bi bi-truck fs-2"></i>
            <h6 class="fw-bold mt-2">Fast Delivery</h6>
            <p class="text-muted small">Track your orders with real-time updates.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-lock fs-2"></i>
            <h6 class="fw-bold mt-2">Secure Checkout</h6>
            <p class="text-muted small">Your payments are encrypted and protected.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-headset fs-2"></i>
            <h6 class="fw-bold mt-2">24/7 Support</h6>
            <p class="text-muted small">We are here to help whenever you need us.</p>
        </div>
    </div>
</section>
