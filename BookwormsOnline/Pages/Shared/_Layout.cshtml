<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookwormsOnline</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookwormsOnline.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <i class="bi bi-book-fill"></i> BookwormsOnline
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Privacy">
                                <i class="bi bi-shield-check"></i> Privacy
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item me-lg-2">
                            <a class="nav-link position-relative" href="#" aria-label="Cart">
                                <i class="bi bi-cart3"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">
                                    0
                                </span>
                            </a>
                        </li>

                        @using Microsoft.AspNetCore.Identity
                        @using BookwormsOnline.Models
                        @inject SignInManager<ApplicationUser> SignInManager
                        @inject UserManager<ApplicationUser> UserManager

                        @{
                            ApplicationUser? currentUser = null;
                            if (SignInManager.IsSignedIn(User))
                            {
                                currentUser = await UserManager.GetUserAsync(User);
                            }
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (SignInManager.IsSignedIn(User) && !string.IsNullOrEmpty(currentUser?.PhotoPath))
                                {
                                    <img src="@currentUser.PhotoPath" alt="Profile Photo" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                @(SignInManager.IsSignedIn(User) ? (User.Identity?.Name ?? "Account") : "Account")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Profile">
                                        <i class="bi bi-person"></i> Profile
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-page="/Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Login">
                                        <i class="bi bi-box-arrow-in-right"></i> Login
                                    </a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Register">
                                        <i class="bi bi-person-plus"></i> Register
                                    </a></li>
                                }
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3"></div>

    <main class="flex-grow-1">
        <div class="container mt-4">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top bg-light text-muted py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 - BookwormsOnline Security Suite - <a asp-area="" asp-page="/Privacy" class="text-muted text-decoration-none">Privacy</a></p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toast-notifications.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["ToastMessage"] is string toastMessage)
    {
        var toastType = TempData["ToastType"] as string ?? "success";
        <script>
            (function () {
                const message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMessage));
                const type = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastType));
                const showToast = function () {
                    if (window.toast && typeof window.toast[type] === 'function') {
                        window.toast[type](message);
                    } else if (window.toast) {
                        window.toast.success(message);
                    } else {
                        console.warn('Toast system not initialized:', message);
                    }
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', showToast);
                } else {
                    showToast();
                }
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>