@page
@model BookwormsOnline.Pages.TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-factor authentication (2FA)";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow">
            <div class="card-body p-5">
                <h2 class="card-title text-center mb-4">
                    <i class="bi bi-shield-check"></i> Two-Factor Authentication
                </h2>

                @if (Model.Is2faEnabled)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-check-circle"></i>
                        <span>2FA is currently enabled.</span>
                    </div>
                    <form method="post" asp-page-handler="Disable">
                        <button type="submit" class="btn btn-danger btn-lg w-100">
                            <i class="bi bi-shield-lock"></i> Disable 2FA
                        </button>
                    </form>

                    <hr class="my-4">

                    <p class="text-center text-muted mb-0">
                        <small>Your account is protected with two-factor authentication.</small>
                    </p>
                }
                else
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>2FA is not yet enabled.</span>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <h6 class="fw-bold mb-3">Setup Instructions</h6>
                        <ol class="mb-0 ps-3 small">
                            <li class="mb-2">
                                Download an authenticator app like Microsoft Authenticator or Google Authenticator.
                            </li>
                            <li class="mb-2">
                                Scan the QR code below or enter the key: <kbd class="small">@Model.SharedKey</kbd>
                            </li>
                            <li>
                                Enter the verification code to complete setup.
                            </li>
                        </ol>
                    </div>

                    <div class="text-center mb-4">
                        <div id="qrCode" class="mb-3">
                            <img src="@Model.QrCodeImage" style="width:180px;height:180px;" alt="QR Code" />
                        </div>
                        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                    </div>

                    <form method="post" asp-page-handler="Enable" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Code" class="form-label">
                                <i class="bi bi-key"></i> Verification Code
                            </label>
                            <input asp-for="Input.Code" class="form-control form-control-lg text-center" 
                                   autocomplete="off" placeholder="000000" inputmode="numeric" />
                            <span asp-validation-for="Input.Code" class="invalid-feedback d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="bi bi-check-circle"></i> Verify and Enable
                        </button>

                        <a asp-page="/Profile" class="btn btn-outline-secondary btn-lg w-100">
                            <i class="bi bi-arrow-left"></i> Back to Profile
                        </a>
                    </form>

                    <hr class="my-4">

                    <p class="text-center text-muted mb-0">
                        <small>Add an extra layer of security to your account.</small>
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
