@page
@{
    ViewData["Title"] = "Locked out";
}

<div class="container py-5">
    <div class="row justify-content-center mt-5">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-lock-fill text-danger" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    <h2 class="card-title text-center fw-bold mb-3">@ViewData["Title"]</h2>
                    <p class="text-center text-muted mb-4">
                        This account has been temporarily locked due to multiple failed login attempts. Please try again later.
                    </p>
                    <p class="text-center text-muted small mb-4">
                        If you believe this is a mistake, please contact our support team.
                    </p>

                    <a asp-page="/Login" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
