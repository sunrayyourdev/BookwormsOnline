@page
@model ErrorModel
@{
    ViewData["Title"] = "Error " + (Model.StatusCode.HasValue ? Model.StatusCode.Value.ToString() : "");
}

<div class="container py-5">
    <div class="row justify-content-center mt-5">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow border-0 text-center">
                <div class="card-body p-5">
                    @if (Model.StatusCode == 404)
                    {
                        <div class="mb-4">
                            <div class="display-1 text-danger fw-bold">404</div>
                        </div>
                        <h2 class="card-title fw-bold mb-3">Page Not Found</h2>
                        <p class="text-muted mb-4">
                            The page you're looking for doesn't exist. It may have been moved or deleted.
                        </p>
                    }
                    else if (Model.StatusCode == 403)
                    {
                        <div class="mb-4">
                            <div class="display-1 text-warning fw-bold">403</div>
                        </div>
                        <h2 class="card-title fw-bold mb-3">Access Denied</h2>
                        <p class="text-muted mb-4">
                            You don't have permission to access this resource.
                        </p>
                    }
                    else
                    {
                        <div class="mb-4">
                            <div class="display-1 text-danger fw-bold">Error</div>
                        </div>
                        <h2 class="card-title fw-bold mb-3">Something Went Wrong</h2>
                        <p class="text-muted mb-4">
                            An unexpected error occurred. Please try again later.
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }


                    <a asp-page="/Index" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-house-door"></i> Go to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
