@page
@model ErrorModel
@{
    ViewData["Title"] = "Error " + (Model.StatusCode.HasValue ? Model.StatusCode.Value.ToString() : "");
}

<div class="text-center mt-5">
    @if (Model.StatusCode == 404)
    {
        <h1 class="display-1 text-danger">404</h1>
        <h2 class="text-secondary">Page Not Found</h2>
    }
    else if (Model.StatusCode == 403)
    {
        <h1 class="display-1 text-warning">403</h1>
        <h2 class="text-secondary">Access Denied</h2>
    }
    else
    {
        <h1 class="display-1 text-danger">Error</h1>
        <h2 class="text-secondary">Something went wrong</h2>
    }

    <p class="lead mt-3">@Model.ErrorMessage</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div class="mt-4">
        <a asp-page="/Index" class="btn btn-primary">Go to Home</a>
    </div>
</div>
